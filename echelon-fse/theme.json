    "styles": {
        "spacing": {
            "blockGap": "1.2rem"
        },
        "blocks": {
            "core/post-content": {
                "spacing": {
                    "margin": {
                        "top": "0px"
                    }
                }
            }
        },
        "elements": {
            "link": {
                "color": {
                    "text": "var(--wp--preset--color--gv-color-primary)"
                },
                "typography": {
                    "textDecoration": "underline"
                }
            },
            "heading": {
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--lato)"
                },
                "color": {
                    "text": "var(--wp--preset--color--gv-color-text-primary)"
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--gv-color-primary)",
                    "text": "var(--wp--preset--color--white)"
                }
            }
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--open-sans)"
        },
        "color": {
            "text": "var(--wp--preset--color--gv-color-text-secondary)"
        }
    },
    "templateParts": [
        {
            "area": "header",
            "name": "header"
        },
        {
